// Rabbit delivery database.
// Ported from the Laravel rabbit-api migrations; money is stored in cents.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  customer
  driver
  admin
}

enum AddressType {
  home
  work
  other
}

enum CodePurpose {
  activation
  password_reset
  login
}

enum OrderStatus {
  pending_payment
  placed
  preparing
  ready // packed, waiting for the driver
  out_for_delivery
  delivered
  cancelled
}

model User {
  id               Int       @id @default(autoincrement())
  name             String    @default("") // asked after the first sign-in
  phone            String    @unique // 10 digits, no country code
  email            String?   @unique
  passwordHash     String?   @map("password_hash") // admins only; customers sign in by SMS code
  role             Role      @default(customer)
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  googleSub        String?   @unique @map("google_sub") // Google account linked for "Continue with Google"
  // Drivers: whether they're taking orders, and from which store.
  driverOnline     Boolean   @default(false) @map("driver_online")
  driverStoreId    Int?      @map("driver_store_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  addresses         UserAddress[]
  verificationCodes VerificationCode[]
  paymentMethods    PaymentMethod[]
  orders            Order[]
  deliveries        Order[]       @relation("OrderDriver")
  favorites         Favorite[]
  driverStore       Store?        @relation("DriverStore", fields: [driverStoreId], references: [id], onDelete: SetNull)

  @@map("users")
}

// One-time SMS codes (sign-in; activation and password_reset are legacy).
model VerificationCode {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  purpose   CodePurpose
  codeHash  String      @map("code_hash")
  attempts  Int         @default(0)
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

model UserAddress {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  type         AddressType @default(home)
  label        String?
  addressLine1 String      @map("address_line_1")
  addressLine2 String?     @map("address_line_2")
  city         String
  provinceCode String      @map("province_code") // e.g. ON
  postalCode   String?     @map("postal_code")
  countryCode  String      @default("CA") @map("country_code")
  latitude     Decimal     @db.Decimal(9, 6)
  longitude    Decimal     @db.Decimal(9, 6)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("user_addresses")
}

model Store {
  id               Int     @id @default(autoincrement())
  name             String
  latitude         Decimal @db.Decimal(9, 6)
  longitude        Decimal @db.Decimal(9, 6)
  deliveryRadiusKm Decimal @default(10) @map("delivery_radius_km") @db.Decimal(5, 2)
  active           Boolean @default(true)

  inventory Inventory[]
  orders    Order[]
  drivers   User[]      @relation("DriverStore")

  @@map("stores")
}

model ProductCategory {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  image       String?
  parentId    Int?     @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  priceCents  Int      @map("price_cents")
  categoryId  Int      @map("category_id")
  image       String
  taxable     Boolean  @default(false) // basic groceries are zero-rated in Canada
  // Variants of one item (2% milk, 4 L) share a group; options holds this
  // variant's value for each of the group's options, e.g. { "Size": "4 L" }.
  groupId     Int?     @map("group_id")
  options     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  group      ProductGroup?   @relation(fields: [groupId], references: [id])
  inventory  Inventory[]
  favorites  Favorite[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([groupId])
  @@map("products")
}

// A family of product variants shown as one tile with option chips.
// options lists each option and its values in display order, e.g.
// [{ "name": "Milk fat", "values": ["Skim", "1%", "2%", "3.25%"] }].
// The group's first product (lowest id) is the one its tile shows.
model ProductGroup {
  id       Int       @id @default(autoincrement())
  title    String
  options  Json
  products Product[]

  @@map("product_groups")
}

// Products a customer has hearted, newest first in the app.
model Favorite {
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

model Inventory {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  productId Int      @map("product_id")
  quantity  Int
  updatedAt DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@map("inventory")
}

model Promotion {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  image       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("promotions")
}

model City {
  id   Int    @id @default(autoincrement())
  name String

  @@map("cities")
}

// A saved card. Card numbers never touch this server: the app collects
// them with Stripe's SDK and we keep only Stripe's id and display details.
model PaymentMethod {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  stripePaymentMethodId String   @unique @map("stripe_payment_method_id")
  brand                 String
  last4                 String
  expMonth              Int      @map("exp_month")
  expYear               Int      @map("exp_year")
  createdAt             DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("payment_methods")
}

model Order {
  id                    Int         @id @default(autoincrement())
  userId                Int         @map("user_id")
  storeId               Int         @map("store_id")
  addressId             Int?        @map("address_id")
  paymentMethodId       Int?        @map("payment_method_id")
  status                OrderStatus @default(pending_payment)
  // Copy of the delivery address at order time, so later edits don't rewrite history.
  deliveryAddress       Json        @map("delivery_address")
  subtotalCents         Int         @map("subtotal_cents")
  taxCents              Int         @map("tax_cents")
  deliveryFeeCents      Int         @default(0) @map("delivery_fee_cents")
  totalCents            Int         @map("total_cents")
  stripePaymentIntentId String?     @unique @map("stripe_payment_intent_id")
  notes                 String?     @db.Text
  contactless           Boolean     @default(false)
  noBell                Boolean     @default(false) @map("no_bell")
  placedAt              DateTime?   @map("placed_at")
  driverId              Int?        @map("driver_id")
  pickedUpAt            DateTime?   @map("picked_up_at")
  deliveredAt           DateTime?   @map("delivered_at")
  deliveryPhoto         String?     @map("delivery_photo") // storage key of the driver's doorstep photo
  // The driver's latest position while this order is on the way.
  driverLatitude        Decimal?    @map("driver_latitude") @db.Decimal(9, 6)
  driverLongitude       Decimal?    @map("driver_longitude") @db.Decimal(9, 6)
  driverLocatedAt       DateTime?   @map("driver_located_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  driver        User?          @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  store         Store          @relation(fields: [storeId], references: [id])
  address       UserAddress?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  items         OrderItem[]

  @@index([userId])
  @@index([storeId, status])
  @@index([driverId, status])
  @@map("orders")
}

model OrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int     @map("order_id")
  productId      Int     @map("product_id")
  title          String // product title at order time
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  taxable        Boolean

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
